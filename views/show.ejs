<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Show post in detail</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h2>here is your post in detail</h1>
    <p>post:id<% post.id %></p>
    <div class="post">
        <h3>@<%= post.username %></h3>
        <p><%= post.content %></p>
    </div>
</body>
</html>