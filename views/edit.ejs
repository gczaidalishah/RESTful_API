<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your post</title>
</head>
<body>
    <h2>Edit your post</h2>
    <p>post id:<%= post.id %></p>
    <p>post username :@<%= post.username %></p>
    <form method="POST" action="/posts/<%= post.id %>?_method=PATCH"> <!-- html only accepts GET and POST methods, so we install a package to handle PATCH requests that is method override -->
        <textarea name="content" rows="10" cols="35" name="content"><%= post.content %></textarea>
        <button type="submit">update</button>
    </form>
    
</body>
</html>